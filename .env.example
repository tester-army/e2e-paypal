# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The sandbox REST app: developer.paypal.com → Apps & Credentials (Sandbox) → your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The sandbox buyer (a US Personal account): developer.paypal.com → Testing Tools → Sandbox Accounts. Only the tests use these.
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
